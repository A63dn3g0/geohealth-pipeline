# GeoHealth Pipeline Environment Configuration
# Copy this file to .env and fill in your actual values

# Python environment
PYTHONUNBUFFERED=1
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL/PostGIS Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=geohealth
POSTGRES_PASSWORD=changeme
POSTGRES_DB=geohealth

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=false

# Dashboard (Streamlit)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Data Paths
DATA_INPUT_DIR=./inputs
DATA_OUTPUT_DIR=./outputs
CONFIG_FILE=./geohealth_config.yaml

# Features
ENABLE_POSTGIS=true
ENABLE_CROSSWALKS=false
ENABLE_DEMO=false

# Security (production only)
SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
API_RATE_LIMIT=100

# Monitoring (optional)
SENTRY_DSN=
ENABLE_TELEMETRY=false
METRICS_PORT=9090
