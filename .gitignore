__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
# Local secrets and IDE
.env
.env.*
!.env.example
.vscode/
.idea/
# Build/generated products
dist/
build/
outputs/
*.gpkg
*.shp
*.shx
*.dbf
